{
  "manifest_version": 3,
  "name": "AI 圆桌 - Multi-AI Roundtable (HAIC)",
  "version": "0.2.0",
  "description": "让多个 AI 助手围桌讨论，交叉评价，深度协作（HAIC 改良：角色前言 / Grok / Cursor / 汇出 / 一键评论）",

  "permissions": [
    "sidePanel",
    "activeTab",
    "tabs",
    "scripting",
    "storage"
  ],

  "host_permissions": [
    "https://claude.ai/*",
    "https://chat.openai.com/*",
    "https://chatgpt.com/*",
    "https://gemini.google.com/*",
    "https://grok.com/*",
    "https://www.grok.com/*",
    "https://cursor.com/*",
    "https://www.cursor.com/*"
  ],

  "side_panel": {
    "default_path": "sidepanel/panel.html"
  },

  "background": {
    "service_worker": "background.js"
  },

  "content_scripts": [
    {
      "matches": ["https://claude.ai/*"],
      "js": ["content/dom-utils.js", "content/claude.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://chat.openai.com/*", "https://chatgpt.com/*"],
      "js": ["content/chatgpt.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://gemini.google.com/*"],
      "js": ["content/dom-utils.js", "content/gemini.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://grok.com/*", "https://www.grok.com/*"],
      "js": ["content/dom-utils.js", "content/grok.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://cursor.com/*", "https://www.cursor.com/*"],
      "js": ["content/dom-utils.js", "content/cursor.js"],
      "run_at": "document_idle"
    }
  ],

  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },

  "action": {
    "default_title": "打开 AI 圆桌"
  }
}
